# geometric-lens — C(x)/G(x) scoring + PC-207 per-token scoring + project
# RAG store. Stateful via the projects PVC (indexed project source) and
# depends on llama-server for embeddings and redis for cache + co-occurrence.
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: lens-projects
  namespace: ${ATLAS_NAMESPACE}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: ${ATLAS_PVC_PROJECTS_SIZE}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: geometric-lens
  namespace: ${ATLAS_NAMESPACE}
spec:
  replicas: 1
  selector:
    matchLabels: {app: geometric-lens}
  template:
    metadata:
      labels: {app: geometric-lens}
    spec:
      containers:
      - name: lens
        image: ghcr.io/${ATLAS_GHCR_OWNER}/atlas-lens:${ATLAS_IMAGE_TAG}
        ports:
        - containerPort: ${ATLAS_LENS_PORT}
          name: http
        env:
        - {name: LLAMA_URL,              value: "http://llama-server:${ATLAS_LLAMA_PORT}"}
        - {name: LLAMA_EMBED_URL,        value: "http://llama-server:${ATLAS_LLAMA_PORT}"}
        - {name: GEOMETRIC_LENS_ENABLED, value: "true"}
        - {name: PROJECT_DATA_DIR,       value: "/data/projects"}
        - {name: REDIS_URL,              value: "redis://redis:${ATLAS_REDIS_PORT}"}
        volumeMounts:
        - name: projects
          mountPath: /data/projects
        readinessProbe:
          httpGet:
            path: /ready          # /ready is strict (PC-019); /health is informational.
            port: ${ATLAS_LENS_PORT}
          initialDelaySeconds: 20
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 6
        livenessProbe:
          httpGet:
            path: /health
            port: ${ATLAS_LENS_PORT}
          initialDelaySeconds: 60
          periodSeconds: 30
        resources:
          requests:
            cpu: ${ATLAS_SERVICE_CPU_REQUEST}
            memory: ${ATLAS_SERVICE_MEMORY_REQUEST}
          limits:
            cpu: ${ATLAS_SERVICE_CPU_LIMIT}
            memory: ${ATLAS_SERVICE_MEMORY_LIMIT}
      volumes:
      - name: projects
        persistentVolumeClaim:
          claimName: lens-projects
---
apiVersion: v1
kind: Service
metadata:
  name: geometric-lens
  namespace: ${ATLAS_NAMESPACE}
spec:
  type: NodePort
  selector: {app: geometric-lens}
  ports:
  - port: ${ATLAS_LENS_PORT}
    targetPort: ${ATLAS_LENS_PORT}
    nodePort: ${ATLAS_LENS_NODEPORT}
    name: http
